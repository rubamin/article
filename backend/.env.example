PORT=5000

# MSSQL
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ArticleTracker
DB_USER=sa
DB_PASSWORD=change_me
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Admin login (JWT). Use a long random value; changing it signs everyone out.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h

# Where the React app is served; used to build links (PUBLIC_APP_URL/r/<share> and /a/<personal>)
PUBLIC_APP_URL=http://localhost:5173

# Comma-separated origins allowed by CORS (leave empty to allow all during development)
CORS_ORIGIN=http://localhost:5173

# Optional: only these email domains may open a share link (comma-separated), e.g. rubamin.com
ALLOWED_EMAIL_DOMAINS=

QUESTION_COUNT=5
